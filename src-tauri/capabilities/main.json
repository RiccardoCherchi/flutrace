{
  "identifier": "main",
  "description": "Local window lifecycle, title bar drag and zoom, and explicit clipboard writes, and sharing the connected session with flutrace-mcp. No clipboard reads.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-frontend-ready",
    "allow-finish-exit",
    "allow-publish-session",
    "clipboard-manager:allow-write-text",
    "allow-start-discovery",
    "allow-discovery-snapshot"
  ]
}
